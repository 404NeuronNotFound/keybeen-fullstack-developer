# Create a Web3Forms access key for your receiving email at https://web3forms.com/
# Copy this file to .env.local, then paste your key after the equals sign.
# Restart the development server after changing this value.
VITE_WEB3FORMS_ACCESS_KEY=

# Server-only AbstractAPI Email Reputation key. Checks run only on Send.
# Never use a VITE_ prefix for this private key.
ABSTRACT_EMAIL_VALIDATION_API_KEY=

# Visitor Mixtape
# Public feature switch: leave false until Supabase is ready, then rebuild/redeploy.
VITE_MIXTAPE_ENABLED=false
# Server-only configuration follows; never prefix these keys with VITE_.
# Run supabase/migrations/202611220001_visitor_mixtape.sql in Supabase first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables in-app song/artist search. Pasted YouTube links work without it.
YOUTUBE_API_KEY=
# Optional stable random signing secret (otherwise the server uses the service key).
MIXTAPE_VISITOR_SECRET=

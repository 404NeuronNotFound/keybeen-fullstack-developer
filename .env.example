# Create a Web3Forms access key for your receiving email at https://web3forms.com/
# Copy this file to .env.local, then paste your key after the equals sign.
# Restart the development server after changing this value.
VITE_WEB3FORMS_ACCESS_KEY=

# Server-only AbstractAPI Email Reputation key. Checks run only on Send.
# Never use a VITE_ prefix for this private key.
ABSTRACT_EMAIL_VALIDATION_API_KEY=
